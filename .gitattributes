# Ensure consistent line endings across platforms
* text=auto eol=lf

# C/C++
*.cpp  text eol=lf diff=cpp
*.hpp  text eol=lf diff=cpp
*.h    text eol=lf diff=cpp
*.c    text eol=lf diff=cpp

# CMake
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
CMakePresets.json text eol=lf

# Qt / QML
*.qml  text eol=lf
*.qrc  text eol=lf
*.ui   text eol=lf
*.ts   text eol=lf linguist-detect

# Config & docs
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
*.clang-format text eol=lf
*.clang-tidy   text eol=lf

# Scripts
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
